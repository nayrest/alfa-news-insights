# Скопируйте в .env и заполните: cp .env.example .env

# --- База данных (используется docker-compose) ---
POSTGRES_DB=insights
POSTGRES_USER=insights
POSTGRES_PASSWORD=insights

# --- LLM (общий ключ команды от организаторов) ---
# Основной и запасной адрес шлюза; при недоступности основного запросы идут на запасной
LLM_BASE_URL=https://changellenge.up.railway.app/v1
LLM_BASE_URL_FALLBACK=https://api.alfahack-gateway26.ru/v1
LLM_API_KEY=
# Разрешённые модели: google/gemma-4-26b-a4b-it, z-ai/glm-5.3-flash, qwen/qwen3.6-35b-a3b,
# deepseek/deepseek-v4.1-flash, qwen/qwen3-vl-30b-a3b-instruct, moonshotai/kimi-k2.6
# Дешёвая модель: план, критик
LLM_MODEL_FAST=google/gemma-4-26b-a4b-it
# Модель для интерпретации
LLM_MODEL_SMART=z-ai/glm-5.3-flash
# Бюджет шлюза — 500 ₽ в день на команду, обновляется в 03:00 МСК.
# Своя защита: не больше N токенов в сутки на весь сервис (подберите по /admin/llm-usage)
LLM_DAILY_TOKEN_LIMIT=2000000

# --- Данные кейса (пути внутри контейнера, папка ./data монтируется в /app/data) ---
COMPANIES_CSV=/app/data/df_Uid_data_hack.csv
PERSONS_CSV=/app/data/df_Fid_Uid_link_hack.csv
PAYMENTS_CSV=/app/data/payments.csv
ALFA_ANALYTICS_DIR=/app/data/alfa_analytics

# --- Новости ---
# Как часто собирать RSS (минуты); 0 — только вручную через POST /news/ingest
NEWS_INGEST_INTERVAL_MIN=30
