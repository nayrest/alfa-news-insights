# false — запросы идут в бэкенд (по умолчанию)
# true — демо-данные из src/mocks, бэкенд не нужен (вёрстка, показ без ключа LLM)
VITE_USE_MOCKS=false

# Базовый путь API. /api проксируется на бэкенд с удалением префикса (vite.config.ts, nginx.conf.template)
VITE_API_URL=/api

# Куда проксировать /api в dev-режиме
BACKEND_URL=http://localhost:8000

# Компании для переключателя в шапке (через запятую). Если их нет в базе — берутся первые 5 крупных.
VITE_COMPANY_IDS=U_34911,U_9250,U_200890,U_102920,U_4909
